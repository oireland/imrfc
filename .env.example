# Copy to .env.local for `pnpm dev` (matches docker-compose.yml).
DATABASE_URL=postgres://imrfc:imrfc@localhost:5432/imrfc

# Mailpit: SMTP on 1025, inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Comma-separated emails that become Admin automatically on first sign-in.
ADMIN_EMAILS=irelandoliver4@gmail.com

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The public address used in links in emails (Announce, Nudge, Notify the team). Defaults to
# BETTER_AUTH_URL when blank. Set it to the live domain, never a preview URL.
APP_URL=

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev only: 1 turns on /api/dev/sign-in?email=you@example.com&next=/ to sign in as an
# existing User without Google or a magic link. Ignored in production and on Vercel.
DEV_SIGN_IN=

# Push notifications. Generate a pair with `npx web-push generate-vapid-keys`; the public
# one is also read client-side (NEXT_PUBLIC_) to subscribe a browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:committee@imrfc.co.uk

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` to
# /api/cron/morning-of. Any random string; set the same value in Vercel's env vars.
CRON_SECRET=
