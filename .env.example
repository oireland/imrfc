# Copy to .env.local for `pnpm dev` (matches docker-compose.yml).
DATABASE_URL=postgres://imrfc:imrfc@localhost:5432/imrfc

# Mailpit: SMTP on 1025, inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Comma-separated emails that become Admin automatically on first sign-in.
ADMIN_EMAILS=irelandoliver4@gmail.com

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev only: 1 turns on /api/dev/sign-in?email=you@example.com&next=/ to sign in as an
# existing User without Google or a magic link. Ignored in production and on Vercel.
DEV_SIGN_IN=
